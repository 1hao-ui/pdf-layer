# 下载的 4 款 OFL 手写字体原件（体积大，由 fetch_fonts.ps1 生成）
fonts/*.ttf
fonts/*.otf

# 私人原件 / 手稿原图：不入库
#   fonts/user/   字嗨导出的原始 OTF（改名为 Z体 之前的原件）
#   my-ziti/      14 张真实手稿照片
#   out/*         切字、标注、样张等中间产物
fonts/user/
my-ziti/
out/*
__pycache__/
*.pyc
# 本地工作区数据（记忆、审查副本），不入库
.workbuddy/

# GUI 控制台记录的修改意见：属于本地使用记录，不入库
feedback.md
# 字体校准表由 fontcal.py 离线生成，可重建，但保留入库便于复现渲染结果
# （若要改成不入库，取消下面一行注释）
# fonts/fontcal.json

# 例外：fonts/ZTi/ 是公开发布的「Z体」字库，必须入库
!fonts/ZTi/
!fonts/ZTi/**

# 例外：fonts/ZTi-Sym/ 是作者手写的「符号字库」（数字/拉丁/希腊/符号，204 字 × 4 套），
# 由 symbols.py 作为手写符号字库加载，必须入库（约 146 KB）
!fonts/ZTi-Sym/
!fonts/ZTi-Sym/**

# 例外：fonts/ZTi-Han/ 是作者手写的「汉字字库」（500 字 × 2 套），
# 由 symbols.py 作为手写汉字库加载，必须入库（约 670 KB）
!fonts/ZTi-Han/
!fonts/ZTi-Han/**
