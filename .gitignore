# 下载的 4 款 OFL 手写字体原件（体积大，由 fetch_fonts.ps1 生成）
fonts/*.ttf
fonts/*.otf

# 私人原件 / 手稿原图：不入库
#   fonts/user/   字嗨导出的原始 OTF（改名为 Z体 之前的原件）
#   my-ziti/      14 张真实手稿照片
#   out/*         切字、标注、样张等中间产物
fonts/user/
my-ziti/
out/*
__pycache__/
*.pyc
# 本地工作区数据（记忆、审查副本），不入库
.workbuddy/

# GUI 控制台记录的修改意见：属于本地使用记录，不入库
feedback.md
# 字体校准表由 fontcal.py 离线生成，可重建，但保留入库便于复现渲染结果
# （若要改成不入库，取消下面一行注释）
# fonts/fontcal.json

# 例外：fonts/ZTi/ 是公开发布的「Z体」字库，必须入库
!fonts/ZTi/
!fonts/ZTi/**

# auto-solve model key/config (local private, do not commit)
llm.json

# Single-file exe exceeds GitHub 100MB limit; publish as split 7z volumes
发布/*.exe

# --smoke 自检产物（每次运行都会重写）
smoke_*.txt
